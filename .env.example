# Rob-LAPI(S)^2 Environment Variables
# Copy this file to .env and fill in your API keys

# Anthropic API Key (required - Claude Sonnet 4.6 is the default model)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (optional - for GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Gemini API Key (optional - for Gemini models)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter fallback (optional - set to true to use OpenRouter as fallback)
# LAPIS_USE_OPENROUTER_FALLBACK=false
# OPENROUTER_API_KEY=your_openrouter_api_key_here
